<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OFC-Meter</AssemblyName>
    <RootNamespace>BgLuck</RootNamespace>
    <HdtDir Condition="'$(HdtDir)' == ''">C:\Users\Admin\AppData\Local\HearthstoneDeckTracker\current</HdtDir>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\OFC.png" />
    <Reference Include="HearthstoneDeckTracker">
      <HintPath>$(HdtDir)\HearthstoneDeckTracker.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HearthDb">
      <HintPath>$(HdtDir)\HearthDb.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
